{
  "private": true,
  "name": "beatify",
  "description": "Build tools for Beatify Home Assistant integration",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:css": "stylelint \"custom_components/beatify/www/css/*.css\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "acorn": "^8.19.0",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "stylelint": "^17.16.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "vitest": "^5.0.0"
  }
}
