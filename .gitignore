# ===========================================
# Beatify — HACS-ready repo
# Only keep files required for HACS install:
#   custom_components/beatify/  hacs.json
#   README.md  LICENSE  images/
# ===========================================

# ---- Dev / build frameworks ----
_bmad/
_bmad-output/
.agentforce/
.claude/
scripts/
docs/
.playwright-mcp/

# ---- Duplicate deployed copy ----
# Match /beatify/ at the root only — NOT custom_components/beatify/
/beatify/

# ---- Secrets ----
.env
*.env.local

# ---- Config & tooling ----
# pyproject.toml is tracked — it hosts the [tool.mypy] config (#1275).
package.json
# package-lock.json wird eingecheckt (#2580, 09.09.2026). Ohne ihn loeste
# jeder CI-Lauf eslint, vitest, vite und rollup innerhalb ihrer Caret-Spannen
# neu auf — direkt unter dem build:check-Tor, das auf byte-gleicher Ausgabe
# beruht. Und ohne ihn ist keine Abhaengigkeits-Anhebung ueberpruefbar.
Makefile
conftest.py
pytest.ini
requirements.txt
# requirements_test.txt intentionally NOT ignored
.ruff.toml

# ---- Tests ----
# tests/ intentionally NOT ignored — test suite is part of the repo
.pytest_cache/
.coverage
coverage.xml
htmlcov/
coverage/
.tox/
.nox/

# ---- Node ----
# Both spellings on purpose: the trailing slash matches the directory, the
# bare name also matches a SYMLINK called node_modules. Agents building in
# throwaway worktrees link the real tree in rather than reinstalling, and on
# 2026-09-06 one such link was committed to main by a `git add -A` — a dead
# absolute path into someone's home directory, for everyone who clones.
node_modules/
node_modules

# ---- Python artifacts ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/

# ---- Linting ----
.ruff_cache/
.mypy_cache/

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Misc ----
config/*
!config/configuration.yaml
community-post.md
*.bak
INFLUENCER_OUTREACH.md
beatify-stats.md
beatify-stats-history.json

# ---- Release notes (keep CHANGELOG.md) ----
RELEASE_NOTES_*.md

# ---- Internal-only docs (not relevant for HACS users) ----
# Keep the public surface to README + CHANGELOG + LICENSE + hacs.json
# + custom_components/beatify/. Everything else is dev/internal noise.
CLAUDE.md
DESIGN.md
# docs/ is already covered by the `docs/` rule on line 14 — no force-add
# exceptions left after this commit.

# ---- GitHub workflows ----
# Track CI workflows (test + HACS validation) so GitHub Actions can run them.
# Untracking the whole .github/ in April 2026 silently broke CI for 2+ months
# and froze the version label drift in #784. Whitelist the workflows we
# actually want CI to execute; ignore everything else under .github/.
.github/*
!.github/workflows/
.github/workflows/*
!.github/workflows/test.yml
!.github/workflows/validate.yml
!.github/workflows/main-artifact-guard.yml

# Test infra needed by CI to run pytest cleanly. Without these, the test
# workflow imports beatify and hits a homeassistant metaclass conflict
# at collection time (root conftest.py stubs HA modules). pytest.ini
# enables asyncio_mode = auto which the async tests require.
!conftest.py
!pytest.ini

# ---- Minified build artefacts (auto-generated, not tracked) ----
# Run `make build` locally or see .github/workflows/build-assets.yml
custom_components/beatify/www/**/*.min.js
custom_components/beatify/www/**/*.min.css
# The pre-compressed `.gz` siblings (#2640) are deliberately NOT listed here.
# HACS copies the repo directory onto the box and runs no build step, so a `.gz`
# that only existed after `npm run build` would never reach a user. They are
# tracked like any other file; `npm run build:check` fails if one goes stale.
scripts/.env
.gstack/

# Local design mockups / scratch HTML — not tracked
mockups/

# Tidal backfill local state (scripts/backfill_tidal.py)
scripts/.tidal-backfill-state.json

# Apple Music backfill local state (scripts/backfill_apple.py)
scripts/.apple-backfill-state.json
